{
    "name": "wapplersystems/infomaniak-vod",
    "type": "typo3-cms-extension",
    "description": "Infomaniak VOD video streaming extension for TYPO3",
    "keywords": ["TYPO3", "extension", "infomaniak", "vod", "video"],
    "homepage": "https://github.com/WapplerSystems/t3-infomaniak-vod",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/WapplerSystems/t3-infomaniak-vod",
        "issues": "https://github.com/WapplerSystems/t3-infomaniak-vod/issues"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\InfomaniakVod\\": "Classes/"
        }
